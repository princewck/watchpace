# Fill this with your own certificate-backed HTTPS origin, without a trailing slash.
PUBLIC_ORIGIN=https://tv.your-domain.example
PORT=3001
SQLITE_PATH=/opt/familytv-gateway/runtime/familytv.sqlite
STATIC_ROOT=/opt/familytv-gateway/public
# Self-hosted history is included; no Apple credentials or payment setup required.
OFFICIAL_CLOUD=false
